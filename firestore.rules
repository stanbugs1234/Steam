rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && myProfile().role == 'admin'
        && myProfile().status == 'approved';
    }

    function isApprovedMember() {
      return isSignedIn() && myProfile().status == 'approved';
    }

    // Members can only read their own doc until approved; approved members
    // can read the directory of other approved members; admins can read
    // everyone (needed for the approval queue).
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isApprovedMember() && resource.data.status == 'approved')
        // A phone-verified signup may look up a bulk-imported roster
        // placeholder matching their own verified phone, to merge into it
        // instead of creating a disconnected duplicate account.
        || (
          uid.matches('imported_.*')
          && request.auth.token.phone_number != null
          && request.auth.token.phone_number == resource.data.phone
        )
      );

      // Self-signup always starts as a pending member; role/status can't be
      // set by the person creating the account. Exception: a phone-verified
      // user may create their own doc pre-approved if it explicitly claims a
      // matching, already-approved import placeholder (verified server-side
      // via get() against their own verified phone) — role is still forced
      // to 'member', so merging can never grant admin.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          (request.resource.data.role == 'member' && request.resource.data.status == 'pending')
          || (
            request.auth.token.phone_number != null
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'approved'
            && request.resource.data.mergedFromId is string
            && request.resource.data.mergedFromId.matches('imported_.*')
            && get(/databases/$(database)/documents/users/$(request.resource.data.mergedFromId)).data.phone == request.auth.token.phone_number
            && get(/databases/$(database)/documents/users/$(request.resource.data.mergedFromId)).data.status == 'approved'
          )
        );

      // Members may edit their own contact info but not their role/status.
      // Admins may edit anything (used to approve/deny and promote members).
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
        || isAdmin()
      );

      // Admins can delete anyone. A phone-verified user may also delete the
      // specific import placeholder they just claimed by matching phone,
      // cleaning up the duplicate once merged into their real account.
      allow delete: if isAdmin() || (
        uid.matches('imported_.*')
        && isSignedIn()
        && request.auth.token.phone_number != null
        && request.auth.token.phone_number == resource.data.phone
      );

      // A member's own check-in history. Doc id is the eventId, so a repeat
      // check-in is a Firestore "update" on an existing doc, which isn't
      // permitted here — that's what makes a scanned code a one-time award.
      match /attendance/{eventId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/events/$(eventId)).data.checkInEnabled == true;
        allow update, delete: if isAdmin();
      }
    }

    match /news/{postId} {
      allow read: if isApprovedMember() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      // Members may only add exactly their own uid to checkedInUserIds, and
      // only when the event has check-in enabled; every other field on the
      // event doc must stay unchanged. Admins can update anything.
      function isSelfCheckInChange() {
        return resource.data.checkInEnabled == true
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.location == resource.data.location
          && request.resource.data.startTime == resource.data.startTime
          && request.resource.data.endTime == resource.data.endTime
          && request.resource.data.needsVolunteers == resource.data.needsVolunteers
          && request.resource.data.checkInEnabled == resource.data.checkInEnabled
          && request.resource.data.checkedInUserIds.size() == resource.data.checkedInUserIds.size() + 1
          && request.resource.data.checkedInUserIds.hasAll(resource.data.checkedInUserIds)
          && request.resource.data.checkedInUserIds.hasAll([request.auth.uid])
          && !resource.data.checkedInUserIds.hasAll([request.auth.uid]);
      }

      // Any approved member may turn check-in on for an event themselves —
      // e.g. whoever's running that meeting, not just an app admin — but
      // only within a window around the event's own time, so it can't be
      // flipped on for an unrelated past/future event.
      function isStartingCheckIn() {
        return resource.data.checkInEnabled == false
          && request.resource.data.checkInEnabled == true
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.location == resource.data.location
          && request.resource.data.startTime == resource.data.startTime
          && request.resource.data.endTime == resource.data.endTime
          && request.resource.data.needsVolunteers == resource.data.needsVolunteers
          && request.resource.data.checkedInUserIds == resource.data.checkedInUserIds
          && request.time > resource.data.startTime - duration.value(30, 'm')
          && request.time < resource.data.endTime + duration.value(2, 'h');
      }

      allow read: if isApprovedMember() || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isApprovedMember() && (isSelfCheckInChange() || isStartingCheckIn()));

      // Members may only toggle their own membership in signedUpUserIds
      // (add or remove exactly their own uid, nothing else); admins manage
      // the slots themselves (label/capacity/create/delete).
      match /volunteerSlots/{slotId} {
        function isSelfSignupChange() {
          let before = resource.data.signedUpUserIds;
          let after = request.resource.data.signedUpUserIds;
          return request.resource.data.label == resource.data.label
            && request.resource.data.capacity == resource.data.capacity
            && (
              (after.size() == before.size() + 1
                && after.hasAll(before)
                && after.hasAll([request.auth.uid])
                && !before.hasAll([request.auth.uid])
                && after.size() <= resource.data.capacity)
              || (before.size() == after.size() + 1
                && before.hasAll(after)
                && before.hasAll([request.auth.uid])
                && !after.hasAll([request.auth.uid]))
            );
        }

        allow read: if isApprovedMember() || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isApprovedMember() && isSelfSignupChange());
      }
    }
  }
}
