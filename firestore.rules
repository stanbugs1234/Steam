rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && myProfile().role == 'admin'
        && myProfile().status == 'approved';
    }

    function isApprovedMember() {
      return isSignedIn() && myProfile().status == 'approved';
    }

    // Members can only read their own doc until approved; approved members
    // can read the directory of other approved members; admins can read
    // everyone (needed for the approval queue).
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isApprovedMember() && resource.data.status == 'approved')
        // A phone-verified signup may look up a bulk-imported roster
        // placeholder matching their own verified phone, to merge into it
        // instead of creating a disconnected duplicate account. (There is
        // deliberately no email equivalent: Firebase issues an email claim for
        // accounts whose email was never verified, so it can't prove who
        // someone is. Email signups are approved by an admin instead.)
        // No `uid.matches('imported_.*')` here on purpose: a query can only be
        // authorised by what it filters on (phone ==), and Firestore can't
        // prove a document-id pattern for a list — with it, the signup lookup
        // was always denied and the merge never happened. Matching the
        // caller's own verified phone is what scopes this.
        || (
          request.auth.token.phone_number != null
          && request.auth.token.phone_number == resource.data.phone
        )
      );

      // Every field a user doc may ever contain. New docs can't carry anything
      // else.
      function hasOnlyKnownUserFields() {
        return request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'kids', 'photoUrl', 'role', 'status', 'createdAt',
          'mergedFromId', 'remindersEnabled', 'duesPaid', 'isNewMember', 'memberNumber',
          'clubPoints', 'yearlyPoints'
        ]);
      }

      // Free-text profile fields a member controls must be the right type and a
      // sane size — one member writing `name: 5` or a huge `kids` list would
      // otherwise break the directory for everybody. A photo can only point at
      // this project's own Storage bucket (no third-party tracking images).
      function hasValidProfileFields() {
        let d = request.resource.data;
        return d.get('name', '') is string && d.get('name', '').size() <= 100
          && d.get('phone', '') is string && d.get('phone', '').size() <= 30
          && d.get('email', '') is string && d.get('email', '').size() <= 200
          && d.get('kids', []) is list && d.get('kids', []).size() <= 12
          && d.get('remindersEnabled', true) is bool
          && (d.get('photoUrl', null) == null
            || (d.photoUrl is string
              && d.photoUrl.size() <= 600
              && d.photoUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/steam-club-app[.].*')));
      }

      // The unclaimed roster placeholder a merging signup says it is claiming.
      function claimedPlaceholder() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.mergedFromId)).data;
      }

      // Points, dues, member number and badges are maintained by the club, not
      // by the person signing up: a fresh signup can't carry any of them...
      function hasNoClubFields() {
        let d = request.resource.data;
        return d.get('yearlyPoints', null) == null
          && d.get('clubPoints', null) == null
          && d.get('memberNumber', null) == null
          && d.get('duesPaid', false) == false
          && d.get('isNewMember', false) == false
          && d.get('mergedFromId', null) == null
          && d.createdAt == request.time;
      }

      // ...and a merge may carry over only what the roster already recorded
      // for that placeholder (omitting a field is fine; inflating one isn't).
      function claimsOnlyRosterValues() {
        let d = request.resource.data;
        let ph = claimedPlaceholder();
        return (d.get('yearlyPoints', null) == null || d.yearlyPoints == ph.get('yearlyPoints', null))
          && (d.get('clubPoints', null) == null || d.clubPoints == ph.get('clubPoints', null))
          && (d.get('memberNumber', null) == null || d.memberNumber == ph.get('memberNumber', null))
          && (d.get('duesPaid', false) == false || d.duesPaid == ph.get('duesPaid', false))
          && (d.get('isNewMember', false) == false || d.isNewMember == ph.get('isNewMember', false))
          && (d.createdAt == request.time || d.createdAt == ph.get('createdAt', null));
      }

      // Self-signup always starts as a pending member; role/status can't be
      // set by the person creating the account. Exception: a phone-verified
      // user may create their own doc pre-approved if it explicitly claims a
      // matching, already-approved import placeholder (verified server-side
      // via get() against their own verified phone) — role is still forced
      // to 'member', so merging can never grant admin.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && hasOnlyKnownUserFields()
        && (
          (request.resource.data.role == 'member'
            && request.resource.data.status == 'pending'
            && hasNoClubFields())
          || (
            request.auth.token.phone_number != null
            && request.resource.data.role == 'member'
            && request.resource.data.status == 'approved'
            && request.resource.data.mergedFromId is string
            && request.resource.data.mergedFromId.matches('imported_.*')
            && claimedPlaceholder().phone == request.auth.token.phone_number
            && claimedPlaceholder().status == 'approved'
            && claimsOnlyRosterValues()
          )
        )
        && hasValidProfileFields();

      // Members may edit only their own profile fields — never role/status
      // or anything the club maintains (points, dues, member number, join
      // date, badges). Admins may edit anything (used to approve/deny,
      // promote members, and record dues/points).
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'kids', 'photoUrl', 'remindersEnabled'])
          && hasValidProfileFields())
        || isAdmin()
      );

      // Admins can delete anyone, and a member can delete their own account
      // (in-app account deletion). A phone-verified user may also delete the
      // specific import placeholder they just claimed by matching phone,
      // cleaning up the duplicate once merged into their real account.
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid) || (
        uid.matches('imported_.*')
        && isSignedIn()
        && request.auth.token.phone_number != null
        && request.auth.token.phone_number == resource.data.phone
      );

      // A member's own check-in history. Doc id is the eventId, so a repeat
      // check-in is a Firestore "update" on an existing doc, which isn't
      // permitted here — that's what makes a scanned code a one-time award.
      match /attendance/{eventId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        // The record must say exactly what the event says, be worth exactly one
        // point, be written while check-in is open, and carry the event's
        // secret code — which only admins can read from Firestore and which
        // is shown only in the QR an admin opens at the meeting. Without it a
        // member couldn't write themselves points from home.
        function isValidCheckIn() {
          let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
          let secret = get(/databases/$(database)/documents/events/$(eventId)/private/checkin).data;
          let d = request.resource.data;
          return ev.checkInEnabled == true
            && d.keys().hasOnly(['eventId', 'eventTitle', 'eventStartTime', 'points', 'checkedInAt', 'code'])
            && d.eventId == eventId
            && d.code == secret.code
            && d.points == 1
            && d.eventTitle == ev.title
            && d.eventStartTime == ev.startTime
            && d.checkedInAt == request.time
            && request.time > ev.startTime - duration.value(30, 'm')
            && request.time < ev.endTime + duration.value(2, 'h');
        }

        allow create: if isApprovedMember() && request.auth.uid == uid && isValidCheckIn();
        allow update: if isAdmin();
        // Members may remove their own record (account deletion). That gains
        // nothing: it removes their point, and re-creating needs the secret.
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // Lets an admin count check-ins for an event across all members.
    match /{path=**}/attendance/{eventId} {
      allow read: if isAdmin();
    }

    match /news/{postId} {
      allow read: if isApprovedMember() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isApprovedMember() || isAdmin();
      allow create, update, delete: if isAdmin();

      // The per-event check-in secret. Admins only — that's what proves a
      // member was actually shown the QR code rather than reading it off
      // Firestore.
      match /private/{doc} {
        allow read, write: if isAdmin();
      }

      // Members may only toggle their own membership in signedUpUserIds
      // (add or remove exactly their own uid, nothing else); admins manage
      // the slots themselves (label/capacity/create/delete). Signing up is
      // only possible until the event ends; leaving is always allowed.
      match /volunteerSlots/{slotId} {
        function isSelfSignupChange() {
          let before = resource.data.signedUpUserIds;
          let after = request.resource.data.signedUpUserIds;
          return request.resource.data.label == resource.data.label
            && request.resource.data.capacity == resource.data.capacity
            && (
              (after.size() == before.size() + 1
                && after.hasAll(before)
                && after.hasAll([request.auth.uid])
                && !before.hasAll([request.auth.uid])
                && after.size() <= resource.data.capacity
                && request.time < get(/databases/$(database)/documents/events/$(eventId)).data.endTime)
              || (before.size() == after.size() + 1
                && before.hasAll(after)
                && before.hasAll([request.auth.uid])
                && !after.hasAll([request.auth.uid]))
            );
        }

        allow read: if isApprovedMember() || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isApprovedMember() && isSelfSignupChange());
      }
    }
  }
}
